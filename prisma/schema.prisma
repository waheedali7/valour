  billingDetails   Json            @map("billing_details")
  shippingDetails  Json            @map("shipping_details")
  shippingMethod   String?         @map("shipping_method") @db.VarChar(100)
  shippingAmount   Decimal         @default(0.00) @map("shipping_amount") @db.Decimal(12, 2)
  discount         Decimal         @default(0.00) @db.Decimal(12, 2)
  subtotal         Decimal         @db.Decimal(12, 2)
  taxAmount        Decimal         @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  total            Decimal         @db.Decimal(12, 2)
  currency         String          @db.Char(3) // SC-10: from setting store_currency
  status           OrderStatus     @default(pending)
  paymentStatus    PaymentStatus   @default(pending) @map("payment_status")
  paymentMethod    String?         @map("payment_method") @db.VarChar(100)
  paymentReference String?         @map("payment_reference") @db.VarChar(255)
  notes            String?         @db.Text
  checkoutToken    String?         @unique @map("checkout_token") @db.VarChar(64)
  couponCode       String?         @map("coupon_code") @db.VarChar(100)
  couponReleasedAt DateTime?       @map("coupon_released_at") @db.DateTime(3)
  placedAt         DateTime?       @map("placed_at") @db.DateTime(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime?       @map("deleted_at") @db.DateTime(3) // never set by the application
  user             User?           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items            OrderItem[]
  payments         Payment[]
  reviews          ProductReview[]

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([userId])
  @@index([placedAt])
  @@map("orders")
}

