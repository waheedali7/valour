enum CategoryType {
  blog
  product
}

enum ProductType {
  watch
  strap
  custom
}

enum ProductStatus {
  draft
  active
  inactive
}

enum PageStatus {
  draft
  published
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum BlogStatus {
  draft
  published
  archived
}

enum CartStatus {
  active
  converted
  abandoned
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
