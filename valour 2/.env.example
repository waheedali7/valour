# Copy to .env.local and adjust. Never commit real values.

# Base URL of the main Valour site (it owns the database and product images).
# The shop page reads /api/storefront/catalog/ from it on every request.
# Product images are proxied to it by next.config.mjs, so set it before `npm run build` too.
# Run the two apps on different ports, e.g. main site on 3000 and this one with `npm run dev -- -p 3001`.
VALOUR_SITE_URL="http://localhost:3000"
