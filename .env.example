# Copy to .env.local and fill in real values there. Never commit real values.
# If the password contains special characters, URL-encode them (@ -> %40, # -> %23).

# The application database (MariaDB/MySQL). This project uses a single database:
# migrations are prepared offline and applied with `prisma migrate deploy` only.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/watchwebsite"

# Admin authentication. Secret: at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# It signs sessions and reset links and encrypts TOTP secrets: changing it signs
# everyone out and requires every admin to set up two-factor again.
# (The older names BETTER_AUTH_SECRET / BETTER_AUTH_URL are still accepted.)
AUTH_SECRET=""
APP_URL="http://localhost:3000"

# Outgoing email for admin password resets (any SMTP server or provider relay).
# Port 465 = implicit TLS; any other port requires STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="VALOUR Admin <no-reply@example.com>"

# Optional, not used in the single-database setup:
# SHADOW_DATABASE_URL  only for `prisma migrate dev` (never used here).
# TEST_DATABASE_URL    the separate watchwebsite_test database; integration tests skip without it.
